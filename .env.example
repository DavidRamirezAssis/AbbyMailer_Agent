# -------------------------------------------------------------
# Variables de entorno: copiar a .env (nunca versionar .env).
# Los secretos van SIN valor. Los parámetros no sensibles llevan
# un valor por defecto documentado.
# -------------------------------------------------------------

# Puerto HTTP del servidor (Render lo asigna en producción).
PORT=3000

# Fecha de referencia (AAAA-MM-DD) para evaluar la vigencia de los soportes
# (vigencia_hasta) y el estado listo_para_firma. DEC-02.
#  - Vacía: se usa la fecha actual del sistema.
#  - Los fixtures se diseñaron alrededor de 2026-09-03 (versión del PRD).
#    Con la fecha actual, la Cámara de Comercio (vence 2026-09-30) bloquea
#    todos los casos.
FECHA_REFERENCIA=2026-09-03

# Proveedor y modelo de lenguaje (DEC-21). Cambiar de modelo no requiere
# modificar código; cambiar de proveedor requiere otra implementación del adaptador.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
LLM_TIMEOUT_MS=60000

# Clave del proveedor de lenguaje. SECRETO: nunca en el repositorio, el front ni los logs.
ANTHROPIC_API_KEY=

# Controles de costo (PRD §8 Costo; CA1).
MAX_ITERACIONES=25
MAX_TOKENS_SESION=90000
LIMITE_PETICIONES_POR_MINUTO=20

# Clave de acceso opcional al link público (PRD §6.1). Vacía: acceso libre.
ACCESS_KEY=
